{
  "name": "@karya/shell",
  "version": "1.0.0-alpha.1",
  "description": "Karya Desktop",
  "author": "Karya",
  "license": "UNLICENSED",
  "homepage": "https://karya.desktop",
  "private": true,
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build --mode production",
    "build:development": "electron-vite build --mode development",
    "build:production": "electron-vite build --mode production",
    "assets:icons": "node ./scripts/generate-icons.mjs",
    "prepare:production": "node ./scripts/prepare-production-app.mjs",
    "start:production": "env -u ELECTRON_RUN_AS_NODE NODE_ENV=production electron .",
    "pack": "pnpm run prepare:production && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "dist": "pnpm run prepare:production && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@karya/content-store": "workspace:*",
    "@karya/core": "workspace:*",
    "@karya/import-service": "workspace:*",
    "@karya/metadata-store": "workspace:*",
    "@karya/platform": "workspace:*",
    "@karya/shell-adapter": "workspace:*",
    "@karya/types": "workspace:*",
    "@karya/ui": "workspace:*",
    "@tanstack/react-query": "^5.64.2",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.38.4",
    "framer-motion": "^11.18.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
