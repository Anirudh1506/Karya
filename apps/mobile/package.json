{
  "name": "@karya/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
