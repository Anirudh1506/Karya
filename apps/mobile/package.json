    "@karya/domain": "workspace:*",
    "@karya/persistence": "workspace:*",
    "@karya/platform": "workspace:*",
    "@karya/query-service": "workspace:*",
    "@karya/resource-service": "workspace:*",
    "@karya/types": "workspace:*",
    "@karya/workspace-service": "workspace:*",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.17.10",
    "expo": "~55.0.0",
    "expo-clipboard": "~55.0.8",
    "expo-crypto": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-secure-store": "~55.0.8",
    "expo-sqlite": "~55.0.10",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.19",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0"
