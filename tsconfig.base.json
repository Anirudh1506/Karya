{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@karya/account-service": ["./packages/account-service/src/index.ts"],
      "@karya/application-registry": ["./packages/application-registry/src/index.ts"],
      "@karya/activity-service": ["./packages/activity-service/src/index.ts"],
      "@karya/content-store": ["./packages/content-store/src/index.ts"],
      "@karya/content-store/node": ["./packages/content-store/src/filesystem-content-store.ts"],
      "@karya/command-registry": ["./packages/command-registry/src/index.ts"],
      "@karya/continuity-service": ["./packages/continuity-service/src/index.ts"],
      "@karya/core": ["./packages/core/src/index.ts"],
      "@karya/domain": ["./packages/domain/src/index.ts"],
      "@karya/event-bus": ["./packages/event-bus/src/index.ts"],
      "@karya/event-service": ["./packages/event-service/src/index.ts"],
      "@karya/import-service": ["./packages/import-service/src/index.ts"],
      "@karya/import-service/node": ["./packages/import-service/src/node-import-source-provider.ts"],
      "@karya/kernel": ["./packages/kernel/src/index.ts"],
      "@karya/metadata-store": ["./packages/metadata-store/src/index.ts"],
      "@karya/notification-service": ["./packages/notification-service/src/index.ts"],
      "@karya/persistence": ["./packages/persistence/src/index.ts"],
      "@karya/platform": ["./packages/platform/src/index.ts"],
      "@karya/profile-service": ["./packages/profile-service/src/index.ts"],
      "@karya/query-service": ["./packages/query-service/src/index.ts"],
      "@karya/relationship-service": ["./packages/relationship-service/src/index.ts"],
      "@karya/resource-service": ["./packages/resource-service/src/index.ts"],
      "@karya/search-service": ["./packages/search-service/src/index.ts"],
      "@karya/settings-service": ["./packages/settings-service/src/index.ts"],
      "@karya/shell-adapter": ["./packages/shell-adapter/src/index.ts"],
      "@karya/state-engine": ["./packages/state-engine/src/index.ts"],
      "@karya/types": ["./packages/types/src/index.ts"],
      "@karya/transport-service": ["./packages/transport-service/src/index.ts"],
      "@karya/ui": ["./packages/ui/src/index.ts"],
      "@karya/workspace-service": ["./packages/workspace-service/src/index.ts"]
    }
  }
}
