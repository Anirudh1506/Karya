{
  "name": "@karya/ksp-conformance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@karya/types": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  },
  "scripts": {
